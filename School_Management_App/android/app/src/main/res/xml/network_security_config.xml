<?xml version="1.0" encoding="utf-8"?>
<!-- Cleartext (http://) is allowed so the apps can talk to a school server on the local network
     (e.g. http://192.168.1.10:8000) during setup. Use https:// for the live server. -->
<network-security-config>
    <base-config cleartextTrafficPermitted="true" />
</network-security-config>
